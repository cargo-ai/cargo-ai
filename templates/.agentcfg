{
  "version": "0.0.10",
  "prompt": "What is 2 + 2? Return the answer as a number.",
  "agent_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "integer",
        "description": "The result of the math problem."
      }
    }
  },
  "resource_urls": [],
  "actions": [
    {
      "name": "is_4",
      "logic": {
        "==": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["Value return is equal to 4."]
        }
      ]
    },
    {
      "name": "is_not_4",
      "logic": {
        "!=": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["Value return is not equal to 4."]
        }
      ]
    }
  ]
}