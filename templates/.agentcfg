{
  "version": "0.0.5",
  "prompt": "What is 2 + 2? Return the answer as a number.",
  "agent_schema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "integer",
        "description": "The result of the math problem."
      }
    }
  },
  "resource_urls": [],
  "actions": [
    {
      "name": "check_answer",
      "logic": {
        "==": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["Correct! 2 + 2 does equal 4."]
        }
      ]
    },
    {
      "name": "wrong_answer",
      "logic": {
        "!=": [ { "var": "answer" }, 4 ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["Incorrect. 2 + 2 does not equal that."]
        }
      ]
    }
  ]
}