{
  "version": "2026-04-06.r1",
  "inputs": [
    {
      "type": "text",
      "text": "Turn the user's request into one concise image-generation prompt for a local image model. Return only image_prompt."
    },
    {
      "name": "request",
      "type": "text"
    }
  ],
  "runtime_vars": {
    "ollama_profile": {
      "type": "string",
      "default": "ollama_images"
    },
    "output_name": {
      "type": "string",
      "default": "ollama-profile-smoke.png"
    }
  },
  "agent_schema": {
    "type": "object",
    "properties": {
      "image_prompt": {
        "type": "string",
        "description": "A concise image prompt derived from the request."
      }
    }
  },
  "actions": [
    {
      "name": "generate_ollama_image",
      "logic": {
        "!=": [{ "var": "image_prompt" }, ""]
      },
      "run": [
        {
          "kind": "generate_image",
          "profile": { "var": "runtime.ollama_profile" },
          "prompt": [{ "var": "image_prompt" }],
          "path": [
            "./artifacts/",
            { "var": "runtime.output_name" }
          ]
        }
      ]
    }
  ]
}
