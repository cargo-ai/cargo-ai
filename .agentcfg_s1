{
  "version": "0.0.5",
  "prompt": "Based on the forecast, determine whether it will rain during the morning commute (7–10am), lunch hours (11am–1pm), and afternoon commute (4–6pm). Set each of the following to true if precipitation probability exceeds 40% for any hour in that range: raining_morning_commute, raining_lunch, and raining_afternoon_commute.",
  "agent_schema": {
    "type": "object",
    "properties": {
      "raining_morning_commute": {
        "type": "boolean",
        "description": "Indicates whether it is raining during the morning commute (7am to 10am)."
      },
      "raining_lunch": {
        "type": "boolean",
        "description": "Indicates whether it is raining around lunchtime (11am to 1pm)."
      },
      "raining_afternoon_commute": {
        "type": "boolean",
        "description": "Indicates whether it is raining during the afternoon commute (4pm to 6pm)."
      }
    }
  },
  "resource_urls": [
    {
      "url": "https://worldtimeapi.org/api/timezone/etc/utc",

      "description": "Current UTC date and time."
    },
    {
      "url": "https://api.open-meteo.com/v1/forecast?latitude=39.10&longitude=-84.51&hourly=precipitation_probability",
      "description": "Hourly precipitation probability for Cincinnati, which my area."
    }
  ],
  "actions": [
    {
      "name": "umbrella_morning_exec",
      "logic": {
        "==": [ { "var": "raining_morning_commute" }, true ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["bring an umbrella for the morning commute"]
        }
      ]
    },
    {
      "name": "umbrella_lunch_exec",
      "logic": {
        "==": [ { "var": "raining_lunch" }, true ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["bring an umbrella for lunchtime"]
        }
      ]
    },
    {
      "name": "umbrella_afternoon_exec",
      "logic": {
        "==": [ { "var": "raining_afternoon_commute" }, true ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["bring an umbrella for the afternoon commute"]
        }
      ]
    },
    {
      "name": "sunglasses_morning_exec",
      "logic": {
        "==": [ { "var": "raining_morning_commute" }, false ]
      },
      "run": [
        {
          "kind": "exec",
          "program": "echo",
          "args": ["bring sunglasses for the morning"]
        }
      ]
    }
  ]
}