{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cargo-ai.org/schemas/usage-maintenance-v1.json",
  "title": "Usage cloud and retention finite result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "result",
    "local",
    "effects",
    "postconditions_verified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "usage cloud status",
        "usage cloud enable",
        "usage cloud disable",
        "usage cloud include-history",
        "usage cloud sync",
        "usage cloud clear",
        "usage cloud history",
        "usage retention status",
        "usage retention preview",
        "usage retention configure"
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/cloud_status"
        },
        {
          "$ref": "#/$defs/cloud_enable"
        },
        {
          "$ref": "#/$defs/cloud_disable"
        },
        {
          "$ref": "#/$defs/cloud_selection"
        },
        {
          "$ref": "#/$defs/cloud_sync"
        },
        {
          "$ref": "#/$defs/cloud_clear"
        },
        {
          "$ref": "#/$defs/cloud_history"
        },
        {
          "$ref": "#/$defs/retention_status"
        },
        {
          "$ref": "#/$defs/retention_preview"
        },
        {
          "$ref": "#/$defs/retention_configure"
        }
      ]
    },
    "local": {
      "$ref": "#/$defs/local_status"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "remote"
      ],
      "properties": {
        "local": {
          "enum": [
            "unapplied",
            "applied",
            "unknown",
            "read_only",
            "requested"
          ]
        },
        "remote": {
          "enum": [
            "unapplied",
            "applied",
            "unknown",
            "read_only",
            "requested"
          ]
        }
      }
    },
    "postconditions_verified": {
      "const": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "usage cloud status"
        },
        "result": {
          "$ref": "#/$defs/cloud_status"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud enable"
        },
        "result": {
          "$ref": "#/$defs/cloud_enable"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud disable"
        },
        "result": {
          "$ref": "#/$defs/cloud_disable"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud include-history"
        },
        "result": {
          "$ref": "#/$defs/cloud_selection"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud sync"
        },
        "result": {
          "$ref": "#/$defs/cloud_sync"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud clear"
        },
        "result": {
          "$ref": "#/$defs/cloud_clear"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage cloud history"
        },
        "result": {
          "$ref": "#/$defs/cloud_history"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage retention status"
        },
        "result": {
          "$ref": "#/$defs/retention_status"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage retention preview"
        },
        "result": {
          "$ref": "#/$defs/retention_preview"
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "usage retention configure"
        },
        "result": {
          "$ref": "#/$defs/retention_configure"
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal_sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Canonical nonnegative decimal sequence in the signed 64-bit database range."
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_binding",
        "source_home_id",
        "data_generation"
      ],
      "properties": {
        "account_binding": {
          "$ref": "#/$defs/uuid"
        },
        "source_home_id": {
          "$ref": "#/$defs/uuid"
        },
        "data_generation": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_epoch",
        "consent_interval"
      ],
      "properties": {
        "lifecycle_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "consent_interval": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "unselected_local": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "source",
        "pending",
        "retained",
        "origin_unverified",
        "unscanned"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "const": false
        },
        "source": {
          "const": null
        },
        "pending": {
          "const": 0
        },
        "retained": {
          "const": 0
        },
        "origin_unverified": {
          "const": 0
        },
        "unscanned": {
          "const": 0
        }
      }
    },
    "selected_local": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "cleared",
        "clear_outcome_unknown",
        "source",
        "provenance",
        "pending",
        "quarantined",
        "retained",
        "origin_unverified",
        "unscanned",
        "unknown_batches",
        "buffered_batches",
        "terminal_unretained_batches",
        "retention_requires_exact_receipt",
        "full_local_restoration_from_cloud"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "cleared": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "origin_unverified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "unscanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "unknown_batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "buffered_batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "terminal_unretained_batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "retention_requires_exact_receipt": {
          "const": true
        },
        "full_local_restoration_from_cloud": {
          "const": false
        },
        "clear_outcome_unknown": {
          "type": "boolean"
        }
      }
    },
    "local_status": {
      "oneOf": [
        {
          "$ref": "#/$defs/unselected_local"
        },
        {
          "$ref": "#/$defs/selected_local"
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "supported_protocol_versions"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "supported_protocol_versions": {
          "const": [
            1
          ]
        }
      }
    },
    "remote_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "capability"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "supported_protocol_versions"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "supported_protocol_versions": {
              "const": [
                1
              ]
            }
          }
        }
      }
    },
    "remote_available": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "capability",
        "account_binding",
        "data_generation",
        "lifecycle_epoch",
        "consent_interval",
        "enabled"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "supported_protocol_versions"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "supported_protocol_versions": {
              "const": [
                1
              ]
            }
          }
        },
        "account_binding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuid"
            }
          ]
        },
        "data_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/counter"
            }
          ]
        },
        "lifecycle_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "consent_interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/counter"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "cloud_status": {
      "oneOf": [
        {
          "$ref": "#/$defs/local_status"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local",
            "remote"
          ],
          "properties": {
            "local": {
              "$ref": "#/$defs/local_status"
            },
            "remote": {
              "oneOf": [
                {
                  "$ref": "#/$defs/remote_unavailable"
                },
                {
                  "$ref": "#/$defs/remote_available"
                }
              ]
            }
          }
        }
      ]
    },
    "cloud_enable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "source",
        "provenance",
        "future_after_sequence",
        "historical_records_selected",
        "readmitted_batches",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "future_after_sequence": {
          "$ref": "#/$defs/decimal_sequence"
        },
        "historical_records_selected": {
          "const": 0
        },
        "readmitted_batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "cloud_disable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "history_deleted",
        "pending_preserved",
        "remote",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "const": false
        },
        "history_deleted": {
          "const": false
        },
        "pending_preserved": {
          "const": true
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol_version",
            "source",
            "enabled"
          ],
          "properties": {
            "protocol_version": {
              "const": 1
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "enabled": {
              "const": false
            }
          }
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "cloud_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "provenance",
        "through_sequence",
        "preview_sha256",
        "selected",
        "upload_started",
        "restored_origin_unverified_records_remain_blocked"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "through_sequence": {
          "$ref": "#/$defs/decimal_sequence"
        },
        "preview_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected": {
          "type": "boolean"
        },
        "upload_started": {
          "const": false
        },
        "restored_origin_unverified_records_remain_blocked": {
          "const": true
        }
      }
    },
    "sync_busy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "busy",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "busy": {
          "const": true
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "sync_empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "batches",
        "blocked",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "batches": {
          "const": 0
        },
        "blocked": {
          "type": "boolean"
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "sync_recovered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "batches",
        "retained_events",
        "recovered",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "batches": {
          "const": 1
        },
        "retained_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "recovered": {
          "const": true
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "sync_pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "batches",
        "custody",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "batches": {
          "const": 1
        },
        "custody": {
          "const": "pending"
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "sync_transmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "batches",
        "ordered_membership_sha256",
        "retained_events",
        "custody",
        "disposition",
        "local"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "batches": {
          "const": 1
        },
        "ordered_membership_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retained_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "custody": {
          "enum": [
            "pending",
            "buffered",
            "retained",
            "analytics_ready"
          ]
        },
        "disposition": {
          "enum": [
            null,
            "pending",
            "terminal_unretained"
          ]
        },
        "local": {
          "$ref": "#/$defs/local_status"
        }
      }
    },
    "cloud_sync": {
      "oneOf": [
        {
          "$ref": "#/$defs/local_status"
        },
        {
          "$ref": "#/$defs/sync_busy"
        },
        {
          "$ref": "#/$defs/sync_empty"
        },
        {
          "$ref": "#/$defs/sync_recovered"
        },
        {
          "$ref": "#/$defs/sync_pending"
        },
        {
          "$ref": "#/$defs/sync_transmitted"
        }
      ]
    },
    "clear_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "source",
        "preview_id",
        "preview_sha256",
        "data_generation"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "preview_id": {
          "$ref": "#/$defs/uuid"
        },
        "preview_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "data_generation": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "clear_confirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "source",
        "cleared",
        "data_generation",
        "purge_state"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "cleared": {
          "const": true
        },
        "data_generation": {
          "$ref": "#/$defs/counter"
        },
        "purge_state": {
          "const": "pending"
        }
      }
    },
    "cloud_clear": {
      "oneOf": [
        {
          "$ref": "#/$defs/clear_preview"
        },
        {
          "$ref": "#/$defs/clear_confirmed"
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "basis",
        "elapsed_ms"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "basis": {
          "const": "monotonic_elapsed"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "original_text",
        "original_sha256",
        "semantic_hash_version",
        "semantic_sha256"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "event_id": {
          "$ref": "#/$defs/logical_event_id"
        },
        "original_text": {
          "type": "string",
          "maxLength": 16384
        },
        "original_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_hash_version": {
          "const": 1
        },
        "semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        }
      }
    },
    "cloud_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "source",
        "high_watermark",
        "events",
        "next_sequence",
        "through_sequence"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "high_watermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history_event"
          },
          "maxItems": 100
        },
        "next_sequence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/counter"
            }
          ]
        },
        "through_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "days",
        "enabled",
        "local_detail_loss_acknowledged",
        "unselected_loss_acknowledged"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "days": {
          "enum": [
            1,
            7,
            30
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "local_detail_loss_acknowledged": {
          "type": "boolean"
        },
        "unselected_loss_acknowledged": {
          "type": "boolean"
        }
      }
    },
    "local_detail_loss": {
      "type": "object",
      "additionalProperties": false,
